{
  "name": "zenon-docs-mcp",
  "version": "0.1.0",
  "description": "MCP server exposing the zenon Online Help (onlinehelp.copadata.com) as search/fetch tools, similar to the Microsoft Learn MCP server.",
  "type": "module",
  "bin": {
    "zenon-docs-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run test/unit test/integration",
    "test:watch": "vitest",
    "test:live": "vitest run test/live",
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^5.2.1",
    "playwright": "^1.48.0",
    "turndown": "^7.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.2",
    "@types/turndown": "^5.0.5",
    "supertest": "^7.2.2",
    "typescript": "^5.6.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=18"
  }
}

{
  "name": "zenon-docs-mcp",
  "version": "0.1.0",
  "description": "MCP server that exposes the zenon Online Help as search and fetch tools for AI assistants.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "zenon",
    "copa-data",
    "documentation",
    "ai"
  ],
  "homepage": "https://github.com/COPA-DATA/zenon-onlinehelp-mcp#readme",
  "bugs": {
    "url": "https://github.com/COPA-DATA/zenon-onlinehelp-mcp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/COPA-DATA/zenon-onlinehelp-mcp.git"
  },
  "author": "Ing. Punzenberger COPA-DATA GmbH",
  "license": "MIT",
  "type": "module",
  "bin": {
    "zenon-docs-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run test/unit test/integration",
    "test:watch": "vitest",
    "test:live": "vitest run test/live",
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^5.2.1",
    "playwright": "^1.48.0",
    "turndown": "^7.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^26.6.5",
    "@types/supertest": "^6.0.2",
    "@types/turndown": "^5.0.5",
    "supertest": "^7.2.2",
    "typescript": "^5.6.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=18"
  }
}

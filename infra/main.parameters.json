{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
      "environmentName": {
        "value": "${AZURE_ENV_NAME}"
      },
      "location": {
        "value": "${AZURE_LOCATION}"
      },
      "zenonDocsMcpExists": {
        "value": "${SERVICE_ZENON_DOCS_MCP_RESOURCE_EXISTS=false}"
      },
      "copatoolsDocsMcpExists": {
        "value": "${SERVICE_COPATOOLS_DOCS_MCP_RESOURCE_EXISTS=false}"
      },
      "copatoolsApiBaseUrl": {
        "value": "${COPATOOLS_API_BASE_URL=https://docs-api-cd.copatools.com}"
      },
      "principalId": {
        "value": "${AZURE_PRINCIPAL_ID}"
      },
      "principalType": {
        "value": "${AZURE_PRINCIPAL_TYPE}"
      }
    }
}
